<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RadiusMal</AssemblyName>
    <RootNamespace>RadiusMal</RootNamespace>
    <ApplicationIcon>RadiusMal.ico</ApplicationIcon>
    <Product>RadiusMal</Product>
    <Description>Radius template to DXF</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="skeleton_r12.dxf" LogicalName="RadiusMal.skeleton_r12.dxf" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>
